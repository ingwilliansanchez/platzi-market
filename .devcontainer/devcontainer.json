{
  "name": "Platzi Market - Angular",
  "dockerComposeFile": "../compose.yml",
  "service": "angular_dev",
  "workspaceFolder": "/usr/src/app",
  "overrideCommand": true,
  "shutdownAction": "stopCompose",
  "forwardPorts": [4200],
  "postCreateCommand": "npm ci",
  "customizations": {
    "vscode": {
      "extensions": ["angular.ng-template"]
    }
  }
}
